# Packaging for CurseForge / GitHub releases (BigWigsMods/packager)
# The addon lives in the repository root; everything else is excluded from the addon zip.
package-as: TheGuildRegistrar

enable-nolib-creation: no

manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown

ignore:
  - peasant
  - docs
  - PLAN.md
  - README.md
  - CHANGELOG.md
  - RELEASE_NOTES.md
  - .vscode
  - .editorconfig
  - .luarc.json
  - .gitattributes
